# RELOOP AI settings. Copy this file to .env and fill in real values locally.
# On Vercel, set the same names in Project Settings -> Environments -> Production -> Environment Variables.
# Never commit .env or paste keys into chat. Every value is optional: anything left empty
# switches that feature off and the site says so honestly.

APP_ENV=development              # use "production" on Vercel

# ---------- Supabase (accounts, donations, directory, knowledge base) ----------
# Project Settings -> Data API (URL) and Project Settings -> API Keys (keys).
SUPABASE_URL=                    # https://<project-ref>.supabase.co  (no /rest/v1 on the end)
SUPABASE_ANON_KEY=               # the PUBLISHABLE key, starts sb_publishable_  (never the secret key)
SUPABASE_SERVICE_ROLE_KEY=       # the SECRET key, starts sb_secret_  (server only)
ADMIN_EMAILS=                    # comma-separated emails that can use /admin

# ---------- AI waste scanner and assistant answers (Anthropic) ----------
#   LLM_PROVIDER=anthropic -> real Claude analysis (key from platform.claude.com, needs credits)
#   LLM_PROVIDER=mock      -> clearly labelled demo answers, no AI, no cost
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=                       # empty = claude-opus-5-5; claude-haiku-5-5 is much cheaper

# ---------- Knowledge base embeddings (Voyage AI) ----------
# Key from dash.voyageai.com. Add a payment method: free-tier limits are too low to load documents.
EMBEDDING_PROVIDER=              # voyage
EMBEDDING_API_KEY=
EMBEDDING_MODEL=                 # empty = voyage-4 (1024 dimensions, matches the database)
# RAG_MIN_SIMILARITY=0.35        # passages below this similarity are ignored

# ---------- Map search (OpenStreetMap, no key needed) ----------
# OSM_USER_AGENT=RELOOP-AI/0.1   # how the app identifies itself to OpenStreetMap

# ---------- Voice agent tools (ElevenLabs) ----------
# Shared secret the ElevenLabs agent sends in the X-Reloop-Voice-Key header.
# At least 32 characters, or the voice API stays off. Make one with:
#   .venv/Scripts/python -c "import secrets; print(secrets.token_urlsafe(32))"
VOICE_TOOL_SECRET=

# ---------- Internal jobs (n8n reel drafts) ----------
# Secret n8n sends in X-Reloop-Internal-Key to /api/internal/*. 32+ characters, or the internal API stays off.
INTERNAL_API_SECRET=
