# Copy this file to .env and fill in real values locally.
# On Vercel, set these in Project Settings -> Environment Variables.
# Never commit .env or paste keys into chat.

APP_ENV=development

# Supabase (knowledge base from Phase 4; accounts in Phase 6). Project Settings -> API.
# The service-role key is server-only: never send it to the browser or commit it.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Vision-capable LLM (Phase 3). Provider is configurable.
#   LLM_PROVIDER=anthropic -> real Claude analysis (needs LLM_API_KEY from console.anthropic.com)
#   LLM_PROVIDER=mock      -> labelled demo answers, no AI, no cost
#   empty                  -> scanner shows "not switched on yet"
# LLM_MODEL defaults to claude-opus-5-5. claude-haiku-5-5 is much cheaper per scan.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# Embeddings for RAG (Phase 4). EMBEDDING_PROVIDER=voyage with a key from dash.voyageai.com.
# EMBEDDING_MODEL defaults to voyage-4 (1024 dimensions, matching the database column).
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
# Optional tuning: passages below this similarity are ignored.
# RAG_MIN_SIMILARITY=0.35

# Maps / Places (Phase 7)
MAPS_API_KEY=
