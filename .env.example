# Copy this file to .env and fill in real values locally.
# On Vercel, set these in Project Settings -> Environment Variables.
# Never commit .env or paste keys into chat.

APP_ENV=development

# Supabase (Phase 6). The service-role key is server-only: never send it to the browser.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Vision-capable LLM (Phase 3). Provider is configurable.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# Embeddings for RAG (Phase 4). Provider is configurable.
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=

# Maps / Places (Phase 7)
MAPS_API_KEY=
